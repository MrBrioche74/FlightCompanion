<Window x:Class="FlightCompanion.NetFramework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flight Companion"
        Width="980"
        Height="720"
        MinWidth="850"
        MinHeight="650"
        Background="#101410"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111611"/>
            <Setter Property="Foreground" Value="#72FF8F"/>
            <Setter Property="BorderBrush" Value="#386742"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="✈ FLIGHT COMPANION"
                           Foreground="#72FF8F"
                           FontFamily="Consolas"
                           FontSize="38"
                           FontWeight="Bold"/>

                <TextBlock Text="Microsoft Flight Simulator 2024"
                           Foreground="#85A58C"
                           FontFamily="Consolas"
                           FontSize="15"
                           Margin="2,5,0,0"/>

                <TextBlock x:Name="AircraftText"
                           Text="Avion : ---"
                           Foreground="#91A797"
                           FontFamily="Consolas"
                           FontSize="14"
                           Margin="2,4,0,0"/>

                <TextBlock x:Name="AircraftProfileText"
                           Text="Profil : ---"
                           Foreground="#91A797"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="2,4,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="#1D281F"
                    BorderBrush="#386742"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10"
                    VerticalAlignment="Center">

                <TextBlock x:Name="StatusText"
                           Text="● Non connecté"
                           Foreground="Orange"
                           FontFamily="Consolas"
                           FontSize="18"
                           FontWeight="Bold"/>

            </Border>

        </Grid>

        <!-- Données de vol -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#202620"
                    BorderBrush="#38473B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="ALTITUDE"
                               Foreground="#A9B8AC"
                               FontFamily="Consolas"
                               FontSize="14"/>

                    <TextBlock x:Name="AltitudeText"
                               Text="----- ft"
                               Foreground="#72FF8F"
                               FontFamily="Consolas"
                               FontSize="29"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Background="#202620"
                    BorderBrush="#38473B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="VITESSE SOL"
                               Foreground="#A9B8AC"
                               FontFamily="Consolas"
                               FontSize="14"/>

                    <TextBlock x:Name="SpeedText"
                               Text="----- kt"
                               Foreground="#72FF8F"
                               FontFamily="Consolas"
                               FontSize="29"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="4"
                    Background="#202620"
                    BorderBrush="#38473B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="VITESSE VERTICALE"
                               Foreground="#A9B8AC"
                               FontFamily="Consolas"
                               FontSize="14"/>

                    <TextBlock x:Name="VSText"
                               Text="----- ft/min"
                               Foreground="#72FF8F"
                               FontFamily="Consolas"
                               FontSize="29"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="6"
                    Background="#202620"
                    BorderBrush="#38473B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="CAP VRAI"
                               Foreground="#A9B8AC"
                               FontFamily="Consolas"
                               FontSize="14"/>

                    <TextBlock x:Name="HeadingText"
                               Text="---°"
                               Foreground="#72FF8F"
                               FontFamily="Consolas"
                               FontSize="29"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Calculateur -->
        <Border Grid.Row="4"
                Background="#202620"
                BorderBrush="#386742"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Saisie -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="CALCULATEUR DE DESCENTE"
                               Foreground="#72FF8F"
                               FontFamily="Consolas"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Les données actuelles proviennent automatiquement de MSFS."
                               Foreground="#91A797"
                               FontFamily="Consolas"
                               FontSize="14"
                               Margin="0,8,0,24"/>

                    <TextBlock Text="ALTITUDE CIBLE"
                               Foreground="#DCE6DE"
                               FontFamily="Consolas"
                               FontSize="15"/>

                    <Grid Margin="0,7,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TargetAltitudeTextBox"
                                 Text="700"
                                 TextChanged="DescentInput_TextChanged"/>

                        <TextBlock Grid.Column="1"
                                   Text="ft"
                                   Foreground="#72FF8F"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                    </Grid>

                    <TextBlock Text="DISTANCE RESTANTE"
                               Foreground="#DCE6DE"
                               FontFamily="Consolas"
                               FontSize="15"/>

                    <Grid Margin="0,7,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DistanceTextBox"
                                 Text="19"
                                 TextChanged="DescentInput_TextChanged"/>

                        <TextBlock Grid.Column="1"
                                   Text="NM"
                                   Foreground="#72FF8F"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                    </Grid>

                    <TextBlock Text="Le calcul se met à jour automatiquement."
                               Foreground="#91A797"
                               FontFamily="Consolas"
                               FontSize="14"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <!-- Résultats -->
                <Border Grid.Column="2"
                        Background="#111611"
                        BorderBrush="#386742"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="VS CONSEILLÉ"
                                   Foreground="#A9B8AC"
                                   FontFamily="Consolas"
                                   FontSize="17"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="RecommendedVsText"
                                   Text="--- ft/min"
                                   Foreground="#72FF8F"
                                   FontFamily="Consolas"
                                   FontSize="44"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,20"/>

                        <TextBlock Text="TOP OF DESCENT"
                                   Foreground="#A9B8AC"
                                   FontFamily="Consolas"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <TextBlock x:Name="TodDistanceText"
                                   Text="--- NM"
                                   Foreground="#72FF8F"
                                   FontFamily="Consolas"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <TextBlock x:Name="TodTimeText"
                                   Text="--- min"
                                   Foreground="#91A797"
                                   FontFamily="Consolas"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,18"/>

                        <TextBlock x:Name="DescentAdviceText"
                                   Text="En attente des données"
                                   Foreground="Orange"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <TextBlock Grid.Row="6"
                   Text="Le résultat suppose une vitesse sol et une descente constantes."
                   Foreground="#77867A"
                   FontFamily="Consolas"
                   FontSize="13"
                   HorizontalAlignment="Center"/>

    </Grid>

</Window>