<Window x:Class="FlightCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flight Companion"
        Width="900"
        Height="600"
        Background="#1B1B1B"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="✈ Flight Companion"
            Foreground="Lime"
            FontSize="34"
            FontWeight="Bold"/>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Margin="10" Background="#2B2B2B" CornerRadius="12">
                <StackPanel Margin="15">
                    <TextBlock Text="Altitude" Foreground="White"/>
                    <TextBlock x:Name="AltitudeText"
                               Text="----- ft"
                               FontSize="30"
                               Foreground="Lime"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="10" Background="#2B2B2B" CornerRadius="12">
                <StackPanel Margin="15">
                    <TextBlock Text="Ground Speed" Foreground="White"/>
                    <TextBlock x:Name="SpeedText"
                               Text="----- kt"
                               FontSize="30"
                               Foreground="Lime"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="10" Background="#2B2B2B" CornerRadius="12">
                <StackPanel Margin="15">
                    <TextBlock Text="Vertical Speed" Foreground="White"/>
                    <TextBlock x:Name="VSText"
                               Text="----- ft/min"
                               FontSize="30"
                               Foreground="Lime"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Margin="10" Background="#2B2B2B" CornerRadius="12">
                <StackPanel Margin="15">
                    <TextBlock Text="Heading" Foreground="White"/>
                    <TextBlock x:Name="HeadingText"
                               Text="---°"
                               FontSize="30"
                               Foreground="Lime"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="10"
                    Background="#2B2B2B"
                    CornerRadius="12">

                <StackPanel Margin="15">

                    <TextBlock Text="Etat SimConnect"
                               Foreground="White"/>

                    <TextBlock x:Name="StatusText"
                               Text="⚪ Non connecté"
                               FontSize="28"
                               Foreground="Orange"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>